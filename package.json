{
  "name": "dsh-recap",
  "version": "0.1.0",
  "description": "Return to a DeepSeek Harness session with a trustworthy, non-intrusive recap.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "lolipop-1x1",
    "email": "59793977+lolipop-1x1@users.noreply.github.com",
    "url": "https://github.com/lolipop-1x1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolipop-1x1/dsh-recap.git"
  },
  "homepage": "https://github.com/lolipop-1x1/dsh-recap#readme",
  "bugs": {
    "url": "https://github.com/lolipop-1x1/dsh-recap/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/host/index.js",
  "types": "./dist/types/host/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/配置说明.md",
    "docs/assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh-plugin",
    "recap",
    "session-summary"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-package.mjs",
    "format": "prettier --write src tests scripts docs *.json *.md *.yml",
    "format:check": "prettier --check src tests scripts docs *.json *.md *.yml",
    "prepack": "npm run build && node scripts/check-package.mjs",
    "docs:config": "node scripts/generate-config.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace-changes": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
